<resources>

    <style name="CalcButton">
        <item name="android:layout_width">0dp</item>
        <item name="android:layout_height">match_parent</item>
        <item name="android:layout_weight">1</item>
        <item name="android:layout_margin">6dp</item>
        <item name="android:textSize">26sp</item>
        <item name="android:textAllCaps">false</item>
        <item name="android:background">@drawable/bg_button_round</item>
        <item name="android:elevation">0dp</item>
        <item name="android:stateListAnimator">@null</item>
    </style>

    <style name="CalcButton.Number">
        <item name="android:backgroundTint">@color/colorNumberBg</item>
        <item name="android:textColor">@color/colorNumberText</item>
    </style>

    <style name="CalcButton.Operator">
        <item name="android:backgroundTint">@color/colorOperatorBg</item>
        <item name="android:textColor">@color/colorOperatorText</item>
    </style>

    <style name="CalcButton.Function">
        <item name="android:backgroundTint">@color/colorFunctionBg</item>
        <item name="android:textColor">@color/colorFunctionText</item>
    </style>

</resources>
