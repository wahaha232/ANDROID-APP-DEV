<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:ads="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="@color/colorBackground"
    android:padding="12dp">

    <!-- Tab bar -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:paddingBottom="8dp">

        <androidx.appcompat.widget.AppCompatButton
            android:id="@+id/tabCalculator"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:background="@null"
            android:text="@string/tab_calculator"
            android:textAllCaps="false"
            android:textColor="@color/colorDisplayText"
            android:textSize="16sp"
            android:textStyle="bold" />

        <androidx.appcompat.widget.AppCompatButton
            android:id="@+id/tabConvert"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:background="@null"
            android:text="@string/tab_convert"
            android:textAllCaps="false"
            android:textColor="@color/colorExpressionText"
            android:textSize="16sp" />

        <androidx.appcompat.widget.AppCompatButton
            android:id="@+id/btnLangToggle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:background="@null"
            android:minWidth="0dp"
            android:paddingStart="8dp"
            android:paddingEnd="0dp"
            android:text="@string/lang_toggle"
            android:textAllCaps="false"
            android:textColor="@color/colorOperatorBg"
            android:textSize="14sp" />

    </LinearLayout>

    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1">

        <!-- Calculator page -->
        <LinearLayout
            android:id="@+id/calculatorContainer"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:orientation="vertical">

            <!-- Display area -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="0dp"
                android:layout_weight="1"
                android:orientation="vertical"
                android:gravity="bottom|end"
                android:paddingBottom="16dp">

                <TextView
                    android:id="@+id/tvExpression"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:textColor="@color/colorExpressionText"
                    android:textSize="24sp"
                    android:gravity="end"
                    android:text="" />

                <TextView
                    android:id="@+id/tvDisplay"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:textColor="@color/colorDisplayText"
                    android:textSize="56sp"
                    android:gravity="end"
                    android:maxLines="1"
                    android:ellipsize="start"
                    android:text="0" />

            </LinearLayout>

            <!-- Button grid -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="0dp"
                android:layout_weight="1"
                android:orientation="vertical">

                <!-- Row 1 -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="0dp"
                    android:layout_weight="1"
                    android:orientation="horizontal">

                    <androidx.appcompat.widget.AppCompatButton
                        android:id="@+id/btnClear"
                        style="@style/CalcButton.Function"
                        android:text="C" />

                    <androidx.appcompat.widget.AppCompatButton
                        android:id="@+id/btnBackspace"
                        style="@style/CalcButton.Function"
                        android:text="⌫" />

                    <androidx.appcompat.widget.AppCompatButton
                        android:id="@+id/btnPercent"
                        style="@style/CalcButton.Function"
                        android:text="%" />

                    <androidx.appcompat.widget.AppCompatButton
                        android:id="@+id/btnDivide"
                        style="@style/CalcButton.Operator"
                        android:text="÷" />

                </LinearLayout>

                <!-- Row 2 -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="0dp"
                    android:layout_weight="1"
                    android:orientation="horizontal">

                    <androidx.appcompat.widget.AppCompatButton android:id="@+id/btn7" style="@style/CalcButton.Number" android:text="7" />
                    <androidx.appcompat.widget.AppCompatButton android:id="@+id/btn8" style="@style/CalcButton.Number" android:text="8" />
                    <androidx.appcompat.widget.AppCompatButton android:id="@+id/btn9" style="@style/CalcButton.Number" android:text="9" />
                    <androidx.appcompat.widget.AppCompatButton android:id="@+id/btnMultiply" style="@style/CalcButton.Operator" android:text="×" />

                </LinearLayout>

                <!-- Row 3 -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="0dp"
                    android:layout_weight="1"
                    android:orientation="horizontal">

                    <androidx.appcompat.widget.AppCompatButton android:id="@+id/btn4" style="@style/CalcButton.Number" android:text="4" />
                    <androidx.appcompat.widget.AppCompatButton android:id="@+id/btn5" style="@style/CalcButton.Number" android:text="5" />
                    <androidx.appcompat.widget.AppCompatButton android:id="@+id/btn6" style="@style/CalcButton.Number" android:text="6" />
                    <androidx.appcompat.widget.AppCompatButton android:id="@+id/btnSubtract" style="@style/CalcButton.Operator" android:text="−" />

                </LinearLayout>

                <!-- Row 4 -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="0dp"
                    android:layout_weight="1"
                    android:orientation="horizontal">

                    <androidx.appcompat.widget.AppCompatButton android:id="@+id/btn1" style="@style/CalcButton.Number" android:text="1" />
                    <androidx.appcompat.widget.AppCompatButton android:id="@+id/btn2" style="@style/CalcButton.Number" android:text="2" />
                    <androidx.appcompat.widget.AppCompatButton android:id="@+id/btn3" style="@style/CalcButton.Number" android:text="3" />
                    <androidx.appcompat.widget.AppCompatButton android:id="@+id/btnAdd" style="@style/CalcButton.Operator" android:text="+" />

                </LinearLayout>

                <!-- Row 5 -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="0dp"
                    android:layout_weight="1"
                    android:orientation="horizontal">

                    <androidx.appcompat.widget.AppCompatButton android:id="@+id/btnSign" style="@style/CalcButton.Function" android:text="+/-" />
                    <androidx.appcompat.widget.AppCompatButton android:id="@+id/btn0" style="@style/CalcButton.Number" android:text="0" />
                    <androidx.appcompat.widget.AppCompatButton android:id="@+id/btnDot" style="@style/CalcButton.Number" android:text="." />
                    <androidx.appcompat.widget.AppCompatButton android:id="@+id/btnEquals" style="@style/CalcButton.Operator" android:text="=" />

                </LinearLayout>

            </LinearLayout>

        </LinearLayout>

        <!-- Convert page -->
        <LinearLayout
            android:id="@+id/convertContainer"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:orientation="vertical"
            android:visibility="gone"
            android:paddingTop="24dp">

            <EditText
                android:id="@+id/etAmount"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:hint="@string/hint_amount"
                android:inputType="numberDecimal"
                android:textColor="@color/colorDisplayText"
                android:textColorHint="@color/colorExpressionText"
                android:textSize="28sp" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:orientation="horizontal"
                android:gravity="center_vertical">

                <Spinner
                    android:id="@+id/spinnerFrom"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1" />

                <androidx.appcompat.widget.AppCompatButton
                    android:id="@+id/btnSwap"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:background="@null"
                    android:text="⇄"
                    android:textColor="@color/colorOperatorBg"
                    android:textSize="22sp" />

                <Spinner
                    android:id="@+id/spinnerTo"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1" />

            </LinearLayout>

            <TextView
                android:id="@+id/tvResult"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="24dp"
                android:gravity="center"
                android:text="0"
                android:textColor="@color/colorOperatorBg"
                android:textSize="40sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/tvStatus"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:gravity="center"
                android:text="@string/status_loading"
                android:textColor="@color/colorExpressionText"
                android:textSize="12sp" />

        </LinearLayout>

    </FrameLayout>

    <!-- 橫幅廣告：正式 AdMob 廣告單元（兩個頁籤共用） -->
    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:gravity="center">

        <com.google.android.gms.ads.AdView
            android:id="@+id/adView"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center"
            ads:adSize="BANNER"
            ads:adUnitId="ca-app-pub-1512317781873771/9473895830" />

    </FrameLayout>

</LinearLayout>
