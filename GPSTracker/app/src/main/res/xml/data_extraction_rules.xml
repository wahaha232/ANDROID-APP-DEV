<?xml version="1.0" encoding="utf-8"?>
<!-- Android 12+ 的備份／裝置轉移規則。本 App 的軌跡、照片與設定（含加密後的 Token）都不交給系統備份，
     與 android:allowBackup="false" 一致；要保留資料請用 App 內的匯出／網站同步。 -->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="root" />
        <exclude domain="file" />
        <exclude domain="database" />
        <exclude domain="sharedpref" />
        <exclude domain="external" />
    </cloud-backup>
    <device-transfer>
        <exclude domain="root" />
        <exclude domain="file" />
        <exclude domain="database" />
        <exclude domain="sharedpref" />
        <exclude domain="external" />
    </device-transfer>
</data-extraction-rules>
