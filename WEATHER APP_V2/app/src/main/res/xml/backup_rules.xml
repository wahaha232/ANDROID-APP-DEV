<full-backup-content>
    <!-- 排除 Room 資料庫與 DataStore 檔案不隨系統自動備份還原，避免跨裝置還原時 schema 不一致 -->
    <exclude domain="database" path="." />
    <exclude domain="sharedpref" path="." />
    <exclude domain="file" path="datastore" />
</full-backup-content>
